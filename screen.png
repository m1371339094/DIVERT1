<!-- Immersive Editorial Hero -->
<div class="w-full bg-surface-container-low border-b border-outline/30 px-8 py-3 flex items-center justify-between"><div class="flex items-center gap-2 text-on-surface-variant font-label-md text-label-md"><span class="hover:text-primary transition-colors cursor-pointer">Safety Companion</span><span class="material-symbols-outlined text-[16px]">chevron_right</span><span class="text-on-surface font-semibold">About &amp; Architecture</span></div><div class="flex items-center gap-2"><span class="px-2.5 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm">v1.0 Architecture</span></div></div><section class="relative w-full overflow-hidden bg-gradient-to-br from-inverse-surface via-primary to-primary-container text-inverse-on-surface px-8 lg:px-16 py-14 shadow-lg">
<!-- Ambient organic light blooms -->
<div class="absolute -right-24 -top-24 w-96 h-96 rounded-full bg-secondary-container/15 blur-3xl pointer-events-none"></div>
<div class="absolute left-1/3 -bottom-20 w-80 h-80 rounded-full bg-tertiary-fixed/20 blur-3xl pointer-events-none"></div>
<div class="relative z-10 max-w-6xl mx-auto flex flex-col items-start gap-6">
<div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-surface-container-lowest/15 backdrop-blur-md text-surface shadow-sm">
<span class="w-2 h-2 rounded-full bg-secondary-fixed animate-pulse"></span>
<span class="font-label-sm text-label-sm uppercase tracking-widest text-primary-fixed">Project DIVERT1</span>
</div>
<div class="space-y-4 max-w-3xl">
<h1 class="font-display text-display lg:text-[44px] lg:leading-[52px] text-surface font-normal tracking-tight">Online Safety <span class="font-headline-lg italic text-tertiary-fixed underline decoration-tertiary-fixed/40 decoration-wavy underline-offset-8">Companion</span> <span class="inline-flex items-center px-2.5 py-0.5 ml-2.5 rounded-md bg-secondary-container text-on-secondary-fixed font-label-sm text-label-sm uppercase tracking-wider font-semibold align-middle -translate-y-1">ALPHA</span></h1>
<p class="font-body-lg text-body-lg text-surface-container-high font-light leading-relaxed">
          A multi-agent AI that explains online risks in plain, calm language — designed from the ground up for neurodivergent young adults navigating scams, fraud, and social pressure online.
        </p>
</div>
<div class="flex flex-wrap items-center gap-3 pt-2">
<span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-container-lowest/10 backdrop-blur-sm text-surface font-label-md text-label-md">
<span class="material-symbols-outlined text-[16px] text-secondary-fixed">shield_lock</span>
          Zero Credential Capture
        </span>
<span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-container-lowest/10 backdrop-blur-sm text-surface font-label-md text-label-md">
<span class="material-symbols-outlined text-[16px] text-primary-fixed">psychology</span>
          Calm Executive Support
        </span>
<span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-container-lowest/10 backdrop-blur-sm text-surface font-label-md text-label-md">
<span class="material-symbols-outlined text-[16px] text-tertiary-fixed">schema</span>
          watsonx Orchestration
        </span>
</div>
</div>
</section>
<!-- Impact Stat Grid -->
<section class="max-w-6xl mx-auto w-full px-6 lg:px-8 -mt-6 z-20">
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
<div class="bg-inverse-surface rounded-xl p-6 shadow-xl flex flex-col justify-between relative overflow-hidden group hover:scale-[1.01] transition-transform">
<div class="absolute right-0 top-0 translate-x-2 -translate-y-2 opacity-10 text-surface">
<span class="material-symbols-outlined text-[88px]">warning_amber</span>
</div>
